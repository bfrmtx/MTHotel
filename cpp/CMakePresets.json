{
  "version": 9,
  "configurePresets": [
    {
      "name": "vscode",
      "displayName": "mthotel",
      "description": "Sets Ninja generator, build and install directory",
      "generator": "Ninja",
      "binaryDir": "${env:HOME}/build/mthotel/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "/usr/local/mthotel",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vscodeInstall",
      "displayName": "mthotelInst",
      "description": "Build all targets",
      "configurePreset": "vscode"
    },
    {
      "name": "install",
      "displayName": "Build && Install (/usr/local/mthotel)",
      "description": "Build all targets and install into CMAKE_INSTALL_PREFIX (/usr/local/mthotel)",
      "configurePreset": "vscode",
      "targets": [
        "install"
      ]
    }
  ]
}